    <string name="pref_learn_title">Belajar dari ketikan</string>
    <string name="pref_learn_desc">Kata yang sering kamu ketik, termasuk nama dan singkatan, naik urutannya di saran. Datanya hanya di perangkat ini dan tidak dikirim ke mana pun. Tidak mencatat di kolom sandi.</string>
