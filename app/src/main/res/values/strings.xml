    <string name="pref_cursor_desc">Tombol di bilah Tools untuk memindah kursor, memilih teks, menyalin, menempel, dan memotong. Ketuk panah, tahan untuk mengulang.</string>
    <string name="pref_cursor_repeat_title">Kecepatan ulang panah</string>
    <string name="pref_cursor_repeat_desc">Jeda antar langkah saat panah ditahan. Makin kecil makin cepat.</string>
